{
  "appId": "com.sogrimhashbon.app",
  "appName": "סוגרים חשבון",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "includePlugins": [
      "@capacitor/app",
      "@capacitor/browser",
      "@capacitor/haptics",
      "@capacitor/share"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert",
        "banner",
        "list"
      ]
    }
  }
}
