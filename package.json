    "native:ios:csr": "powershell -ExecutionPolicy Bypass -File scripts/new-apple-distribution-csr.ps1",
    "native:ios:prepare-release": "npm run native:ios:flatten-icon && npm run native:prepare && node scripts/prepare-ios-release.mjs",
    "qa:ios": "node scripts/verify-ios-submission.mjs",
    "qa:ios:artifact": "node scripts/verify-ios-artifact.mjs",
    "qa:ios:review": "node scripts/verify-ios-review-live.mjs",
    "qa:android-native": "node scripts/verify-android-native-smoke.mjs",
    "qa:android-journey": "node scripts/verify-android-user-journey.mjs",
    "qa:android-font-scale": "node scripts/verify-android-font-scale.mjs",
    "qa:android-benchmark": "node scripts/benchmark-android-startup.mjs",
    "qa:android-update": "node scripts/verify-mandatory-android-update.mjs",
    "qa:scale": "node scripts/benchmark-data-scale.mjs",
    "qa:contention": "node scripts/benchmark-shared-event-contention.mjs",
