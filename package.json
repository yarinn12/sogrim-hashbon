    "db:apply:deleted-profile-redaction": "node scripts/apply-deleted-account-profile-redaction.mjs --apply",
    "qa:capacity": "npm run qa:scale && npm run qa:contention",
    "qa:staging-load": "node scripts/probe-staging-capacity.mjs",
    "qa:ui-scale": "node scripts/benchmark-large-event-ui.mjs",
    "qa:production": "node scripts/verify-production-availability.mjs",
    "qa:production:strict": "node scripts/verify-production-availability.mjs --strict",
    "qa:recovery:strict": "node scripts/verify-production-availability.mjs --strict --allow-origin-backed-shell",
    "qa:failover": "node scripts/verify-production-failover.mjs",
    "qa:public-origin": "node scripts/verify-public-origin-readiness.mjs",
    "qa:public-origin:ios": "node scripts/verify-public-origin-readiness.mjs --ios",
    "qa:store": "node scripts/verify-store-readiness.mjs",
    "store:assets": "node scripts/generate-store-screenshots.mjs",
    "store:review-account": "node scripts/setup-store-review-account.mjs"
