    "native:android": "npm run native:prepare && cap open android",
    "security:migrate-private": "node scripts/migrate-local-private-material.mjs",
    "native:android:key": "node scripts/setup-android-upload-key.mjs",
    "native:android:apk": "npm run native:prepare && node scripts/build-android-apk.mjs",
