    "qa:auth-live": "node scripts/verify-auth-recovery-live.mjs",
    "qa:two-account-live": "node scripts/verify-two-account-event-live.mjs",
    "qa:friends-live": "node scripts/verify-friend-network-live.mjs",
    "qa:notifications-live": "node scripts/verify-notification-inbox-live.mjs",
    "qa:feedback-live": "node scripts/verify-app-feedback-live.mjs",
    "qa:metrics-live": "node scripts/verify-product-metrics-live.mjs",
    "metrics:report": "node scripts/report-product-metrics.mjs",
    "qa:operations": "node scripts/verify-operational-readiness-live.mjs",
    "qa:snapshots-live": "node scripts/audit-snapshot-validation-live.mjs",
